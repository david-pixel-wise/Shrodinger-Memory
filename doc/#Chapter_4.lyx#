\begin_layout Subsection
Experiment 1:
 two independent qubits
\end_layout

\begin_layout Standard
\align center
\begin_inset Graphics
	filename ../img/exp1_ibm_visualization1.png
	lyxscale 30
	scale 30

\end_inset


\end_layout

\begin_layout Standard
\align right
