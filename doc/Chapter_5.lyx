def bits_to_card(bitstring:
 str) -> str:
\end_layout

\begin_layout Plain Layout
sign = '+' if bitstring[-1] == '0' else '-'
\end_layout

\begin_layout Plain Layout
idx = int(bitstring[-4:-1],
 2) # three bits -> 0-7
\end_layout

\begin_layout Plain Layout
return f"{sign}{EMOJIS[idx]}"
\end_layout

